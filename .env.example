# ────────────────────────────────────────────────────────────────
# docker compose 用的环境变量（复制成 .env 后填）
#
# ⚠️ 这个文件会被 git 跟踪，**别往里放真密钥**；.env 已被 .gitignore 排除。
#
# 两个 .env 的分工：
#   本文件（./.env）                        → 主服务配置 + compose 变量插值
#   ../AI派蒙服务器/ai-service/.env          → AI 服务自己的密钥（DEEPSEEK_API_KEY 等，照 .env.example 建）
#
# 生成强随机密钥：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# ────────────────────────────────────────────────────────────────

# ── 镜像与路径（云端指向 ACR；本地保持默认即可）──
# SERVER_IMAGE=registry.cn-hangzhou.aliyuncs.com/<命名空间>/teyvat-guide-server:0.1.0
# WEB_IMAGE=registry.cn-hangzhou.aliyuncs.com/<命名空间>/teyvat-guide-web:0.1.0
# AI_IMAGE=registry.cn-hangzhou.aliyuncs.com/<命名空间>/teyvat-ai:0.1.0
# AI_SERVICE_CONTEXT=../AI派蒙服务器/ai-service

# 本机验证端口（云上由外层 Nginx/HTTPS 接管）
# WEB_PORT=8088

# ── 数据库（M3：RDS 或容器内 MySQL）──
# 本地验证：指向宿主 MySQL —— 注意宿主 MySQL 得允许来自 Docker 网段的连接：
#   CREATE USER 'teyvat'@'%' IDENTIFIED BY '<密码>'; GRANT ALL ON teyvat_guide.* TO 'teyvat'@'%';
TEYVAT_DATABASE_HOST=host.docker.internal
TEYVAT_DATABASE_PORT=3306
TEYVAT_DATABASE_USER=root
TEYVAT_DATABASE_PASSWORD=
TEYVAT_DATABASE_NAME=teyvat_guide

# ── AI 服务对接（必须与 AI 服务 .env 里的 AI_SERVICE_KEY 完全一致）──
AI_SERVICE_KEY=

# ── 鉴权：三把钥匙各自独立、都要强随机（复用会被 web/11 §6 判为不合格）──
TEYVAT_AUTH_JWT_SECRET=
TEYVAT_AUTH_ADMIN_KEY=
TEYVAT_AUTH_INTERNAL_KEY=

# 首次启动的种子账号（用户表为空时自动创建）；建完后建议改密或清空这两个值
TEYVAT_AUTH_SEED_USER=admin
TEYVAT_AUTH_SEED_PASS=

# ── 运行参数（一般不用改）──
# TEYVAT_SERVER_MODE=release
# TEYVAT_LOG_MODE=json
# TEYVAT_LOG_LEVEL=info
# TEYVAT_QUOTA_DAILY_TOKENS_PER_USER=100000
# TEYVAT_QUOTA_DAILY_TOKENS_GLOBAL=0
