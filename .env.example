# ────────────────────────────────────────────────────────────────
# docker compose 用的环境变量（复制成 .env 后填）
#
# ⚠️ 这个文件会被 git 跟踪，**别往里放真密钥**；.env 已被 .gitignore 排除。
#
# 两个 .env 的分工：
#   本文件（./.env）                        → 主服务配置 + compose 变量插值
#   ../AI派蒙服务器/ai-service/.env          → AI 服务自己的密钥（DEEPSEEK_API_KEY 等，照 .env.example 建）
#
# 生成强随机密钥：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# ────────────────────────────────────────────────────────────────

# ── 镜像与路径（云端指向 ACR；本地保持默认即可）──
# ⚠️ ACR 域名有两代（官方《创建个人版容器镜像实例》：2024-09-09 起新建的个人版实例域名改版）：
#     新版： crpi-xxxx.cn-<地域>.personal.cr.aliyuncs.com/<命名空间>/<仓库>:<标签>
#     旧版： registry.cn-<地域>.aliyuncs.com/<命名空间>/<仓库>:<标签>
#   你是哪种，以控制台「仓库管理 → 访问凭证」给出的 docker login 命令为准（host 部分照抄）。
# SERVER_IMAGE=crpi-xxxx.cn-hangzhou.personal.cr.aliyuncs.com/<命名空间>/teyvat-guide-server:0.1.0
# WEB_IMAGE=crpi-xxxx.cn-hangzhou.personal.cr.aliyuncs.com/<命名空间>/teyvat-guide-web:0.1.0
# AI_IMAGE=crpi-xxxx.cn-hangzhou.personal.cr.aliyuncs.com/<命名空间>/teyvat-ai:0.1.0
# AI_SERVICE_CONTEXT=../AI派蒙服务器/ai-service

# 本机验证端口（云上由外层 Nginx/HTTPS 接管）
# WEB_PORT=8088

# ── 数据库（2026-09-19 起：阿里云 RDS，业务库与后台库同一实例）──
# 账号 teyvat 只有 teyvat_guide.* 的权限（后台另用 teyvat_ops 连 teyvat_admin，见 demo-app/.env.local）
# 端口：外网入口 3306；ECS 就位后换内网地址（同地域走内网，安全组/白名单只放 ECS 内网 IP）
#   ⚠️ 别把 @@port（服务器内部端口，本实例是 3009）当成连接端口
TEYVAT_DATABASE_HOST=rm-xxxxxxxxxxxx.mysql.rds.aliyuncs.com
TEYVAT_DATABASE_PORT=3306
TEYVAT_DATABASE_USER=teyvat
TEYVAT_DATABASE_PASSWORD=
TEYVAT_DATABASE_NAME=teyvat_guide

# 本地不接 RDS、想用宿主 MySQL 联调时（容器需能访问宿主，Linux 要 extra_hosts）：
# TEYVAT_DATABASE_HOST=host.docker.internal
# TEYVAT_DATABASE_USER=root

# ── AI 服务对接（必须与 AI 服务 .env 里的 AI_SERVICE_KEY 完全一致）──
AI_SERVICE_KEY=

# ── 鉴权：三把钥匙各自独立、都要强随机（复用会被 web/11 §6 判为不合格）──
TEYVAT_AUTH_JWT_SECRET=
TEYVAT_AUTH_ADMIN_KEY=
TEYVAT_AUTH_INTERNAL_KEY=

# 首次启动的种子账号（用户表为空时自动创建）；建完后建议改密或清空这两个值
TEYVAT_AUTH_SEED_USER=admin
TEYVAT_AUTH_SEED_PASS=

# ── 运行参数（一般不用改）──
# TEYVAT_SERVER_MODE=release
# TEYVAT_LOG_MODE=json
# TEYVAT_LOG_LEVEL=info
# TEYVAT_QUOTA_DAILY_TOKENS_PER_USER=100000
# TEYVAT_QUOTA_DAILY_TOKENS_GLOBAL=0
