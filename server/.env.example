# 复制为 .env 后按需修改（环境变量前缀 TEYVAT_，点号替换为下划线）
TEYVAT_SERVER_PORT=8080
TEYVAT_SERVER_MODE=debug
TEYVAT_DATABASE_DRIVER=mysql
TEYVAT_DATABASE_HOST=127.0.0.1
TEYVAT_DATABASE_PORT=3306
TEYVAT_DATABASE_USER=root
TEYVAT_DATABASE_PASSWORD=root
TEYVAT_DATABASE_NAME=teyvat_guide
TEYVAT_DATABASE_DSN=
TEYVAT_AI_PROVIDER=mock
TEYVAT_AI_API_KEY=
TEYVAT_AI_BASE_URL=https://api.openai.com/v1
TEYVAT_AI_MODEL=gpt-4o-mini
TEYVAT_AUTH_JWT_SECRET=change-me-in-production
# 管理接口密钥（X-Admin-Key），供外部后台系统调用 /api/admin/*
TEYVAT_AUTH_ADMIN_KEY=
