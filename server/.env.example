# 复制为 .env 后按需修改（环境变量前缀 TEYVAT_，点号替换为下划线）
TEYVAT_SERVER_PORT=8080
TEYVAT_SERVER_MODE=debug
TEYVAT_DATABASE_DRIVER=mysql
TEYVAT_DATABASE_HOST=127.0.0.1
TEYVAT_DATABASE_PORT=3306
TEYVAT_DATABASE_USER=root
TEYVAT_DATABASE_PASSWORD=root
TEYVAT_DATABASE_NAME=teyvat_guide
TEYVAT_DATABASE_DSN=
# AI 供应商：mock | openai | remote（remote = 独立 AI 派蒙服务）
TEYVAT_AI_PROVIDER=remote
TEYVAT_AI_BASE_URL=http://127.0.0.1:8090
# remote 模式下为 AI 服务密钥（X-AI-Key），生产环境必须用环境变量注入
TEYVAT_AI_API_KEY=
TEYVAT_AI_MODEL=deepseek-flash
TEYVAT_AI_TIMEOUT_SECONDS=65
TEYVAT_AUTH_JWT_SECRET=change-me-in-production
# 管理接口密钥（X-Admin-Key），供外部后台系统调用 /api/admin/*
TEYVAT_AUTH_ADMIN_KEY=
# 内网管理接口密钥（X-Internal-Key），供后台运维系统调用 /internal/v1/admin/*
# 未配置时该组接口不注册；必须独立生成，禁止复用 admin_key / jwt_secret / X-AI-Key
TEYVAT_AUTH_INTERNAL_KEY=
